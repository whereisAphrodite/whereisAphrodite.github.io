{
  "name": "whereisaphrodite-blog",
  "version": "1.0.0",
  "private": true,
  "description": "Markdown sources for whereisAphrodite",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "CHOKIDAR_USEPOLLING=1 CHOKIDAR_INTERVAL=500 hexo server --draft --ip 127.0.0.1",
    "new": "hexo new draft",
    "ready": "hexo publish",
    "build": "hexo clean && hexo generate",
    "test": "npm run build && node tools/check.cjs"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "dependencies": {
    "hexo": "8.1.2",
    "hexo-generator-archive": "2.0.0",
    "hexo-generator-index": "4.0.0",
    "hexo-generator-tag": "2.0.0",
    "hexo-renderer-marked": "7.0.1",
    "hexo-renderer-stylus": "3.0.1",
    "hexo-server": "3.0.0",
    "hexo-theme-next": "8.29.0"
  }
}
